# DNA web: Docker stack settings.
#   cp deploy/.env.example deploy/.env      (deploy/.env is gitignored)
#
# Every value below is a DEV placeholder. Before this stack is reachable by anyone else
# (LAN demo, server): change POSTGRES_PASSWORD, the bootstrap manager password and the
# SePay key, and replace the demo bank values. Do not commit deploy/.env.

# --- PostgreSQL ---
POSTGRES_DB=dna
POSTGRES_USER=dna
POSTGRES_PASSWORD=dna-dev-pass

# --- First admin account ---
# Created once, only while the app_user table is empty. Password must be >= 12 characters.
# DEV ONLY: change the password (admin: change own password) or reset it with the SQL
# runbook in docs/deployment-guide.md.
DNA_BOOTSTRAP_MANAGER_USERNAME=owner
DNA_BOOTSTRAP_MANAGER_PASSWORD=Dna-Dev-2026-Owner!

# --- API profiles (optional) ---
# Default is docker,mail: notifications go to Mailpit. Use "docker" alone to only log them.
# DNA_API_PROFILES=docker,mail

# --- Site ---
# Base URL used in email links, canonical URLs and the sitemap.
DNA_SITE_URL=http://localhost:8000
# From address of outgoing email (Mailpit accepts any).
DNA_MAIL_FROM=no-reply@dnahoangnguyen.vn
# Public forms per client IP and 10 minutes. Docker Desktop shows every local visitor as one
# address, so the production defaults (5 orders, 5 quotes, 10 order lookups) are raised here.
DNA_ORDER_RATE_LIMIT=50
DNA_QUOTE_RATE_LIMIT=50
DNA_LOOKUP_RATE_LIMIT=100
# Interface the site (port 8000) listens on. 0.0.0.0 = reachable from the LAN (phone test),
# 127.0.0.1 = this machine only.
HTTP_BIND=127.0.0.1
# Load the 32 products / 69 SKUs on start (idempotent: existing SKU codes are skipped).
# Set to false once the catalogue is in the database.
DNA_SEED_CATALOGUE_ENABLED=true
# Demo: publish the seeded products so the storefront shows data right after the first start.
# Leave false when the owner should review and publish each product himself.
DNA_SEED_CATALOGUE_PUBLISH=true

# --- SePay bank webhook ---
# false = webhook returns 404 and payments are marked by hand ("Đã nhận tiền").
DNA_SEPAY_ENABLED=true
# Comma-separated; the webhook accepts "Authorization: Apikey <key>" for any listed key.
# DEV PLACEHOLDER: replace with a long random key.
DNA_SEPAY_WEBHOOK_KEYS=dev-sepay-key-change-me
# Account number SePay reports; must equal the bank account below for auto-matching.
DNA_SEPAY_ACCOUNT_NO=0123456789

# --- Bank transfer details (demo placeholders) ---
# Shown to customers and encoded in the VietQR. Replace with the real company account in
# /admin/settings (or here) before go-live.
DNA_BANK_NAME="Ngân hàng TMCP Quân đội (MB)"
DNA_BANK_BIN=970422
DNA_BANK_ACCOUNT_NO=0123456789
DNA_BANK_ACCOUNT_NAME="CONG TY TNHH DNA HOANG NGUYEN"
