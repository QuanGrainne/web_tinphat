# Routes shared by the local Caddyfile and Caddyfile.prod; imported inside the site block.
# Each main file defines the (api_proxy) snippet these routes use.
encode zstd gzip

header {
	X-Content-Type-Options nosniff
	X-Frame-Options DENY
	Referrer-Policy strict-origin-when-cross-origin
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	-Server
}

handle /actuator* {
	respond "Not Found" 404
}

# bank webhook payloads are tiny
handle /api/webhooks/* {
	request_body {
		max_size 64KB
	}
	import api_proxy
}

# catalogue site: ordering and quote requests are switched off at the edge
handle /api/public/orders* {
	respond "Not Found" 404
}

handle /api/public/quotes* {
	respond "Not Found" 404
}

# admin image upload; the API itself refuses files over 5 MB
handle /api/admin/imports/* {
	request_body {
		max_size 8MB
	}
	import api_proxy
}

handle /api/admin/uploads/* {
	request_body {
		max_size 8MB
	}
	import api_proxy
}

handle /api/* {
	request_body {
		max_size 2MB
	}
	import api_proxy
}

handle /uploads/* {
	root * /srv
	file_server
}

handle {
	reverse_proxy web:3000
}
