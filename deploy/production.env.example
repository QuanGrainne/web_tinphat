# Settings for the VPS. On the server:
#   cp deploy/production.env.example deploy/.env && nano deploy/.env
# Fill every value marked FILL. deploy/.env is gitignored: never commit it, never paste it in a chat.

# --- Site ---
# Domain without https:// (Caddy serves it and redirects www to it)
SITE_DOMAIN=tinphatdecor.com
# Full address: canonical URLs, sitemap and the links in password-reset emails
DNA_SITE_URL=https://tinphatdecor.com
# prod: Secure session cookie, JSON logs. mail: send email through the SMTP settings below
DNA_API_PROFILES=prod,mail

# --- PostgreSQL ---
POSTGRES_DB=dna
POSTGRES_USER=dna
# FILL: a long random value, e.g. the output of: openssl rand -hex 24
# Read only when the database volume is created the first time.
POSTGRES_PASSWORD=

# --- First admin account ---
# Only used while the database has no account. Leave empty when you restore a backup from your
# computer (the accounts come with it). For an empty start, fill both, log in and change the password.
DNA_BOOTSTRAP_MANAGER_USERNAME=
DNA_BOOTSTRAP_MANAGER_PASSWORD=

# --- Email (Gmail SMTP): password reset ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
# FILL: the Gmail address and its 16-letter app password (not the normal Gmail password)
SMTP_USERNAME=
SMTP_PASSWORD=
DNA_MAIL_FROM=

# --- Catalogue ---
DNA_SEED_CATALOGUE_ENABLED=false
DNA_SEED_CATALOGUE_PUBLISH=false
